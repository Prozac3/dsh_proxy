# Browser-visible origin. Its authority is passed to dsh as --trusted-host.
PUBLIC_ORIGIN=http://127.0.0.1:3000

# Cookie login in front of Harness's own token/cookie authentication.
AUTH_USER=admin-user
AUTH_PASS=replace-this-password
SESSION_SECRET=replace-with-openssl-rand-hex-32
SESSION_HOURS=12

# Command used to launch an unmodified DeepSeek Harness installation.
DSH_BIN=dsh
DSH_ARGS_JSON=["web"]
# Working directory for the DSH process. Set this when launching a source checkout or built checkout.
# DSH_CWD=/workspace/github/deepseek-harness
MANAGE_DSH=1

# Only needed when MANAGE_DSH=0: the launch token printed by the external dsh web process.
# DSH_LAUNCH_TOKEN=
